server:
  port: 8080
  servlet:
    context-path: /api

spring:
  application:
    name: ecommerce-backend

  datasource:
    url: jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
    username: root
    password: 
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 5
      idle-timeout: 30000
      connection-timeout: 20000

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        format_sql: true
        default_batch_fetch_size: 20
    open-in-view: false

  servlet:
    multipart:
      enabled: true
      max-file-size: 5MB
      max-request-size: 10MB

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Ho_Chi_Minh
    default-property-inclusion: non_null

# ⚠️ JWT secret phải là chuỗi Base64 chuẩn (chỉ A-Z a-z 0-9 + / =)
jwt:
  secret: 
  access-token-expiration: 
  refresh-token-expiration: 

file:
  upload-dir: ./uploads/products
  base-url: http://localhost:8080/api/files

vnpay:
  tmn-code: 
  hash-secret: 
  pay-url: 
  return-url: 
  ipn-url: 
  version: "2.1.0"
  command: pay
  order-type: other
  locale: vn
  curr-code: VND

cloudinary:
  cloud-name:       # ← thay bằng của bạn
  api-key: 
  api-secret: 

cors:
  allowed-origins:
    - http://localhost:3000
    - http://localhost:5173

logging:
  level:
    com.ecommerce: DEBUG
    org.springframework.security: INFO
    org.hibernate.SQL: DEBUG

management:
  endpoints:
    web:
      exposure:
        include: health,info